{
  "name": "paperhue-web",
  "version": "0.0.0",
  "private": true,
  "description": "Paperhue (紙彩): put photos on ULANI e-paper devices from a browser or the Android app",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@capacitor-community/bluetooth-le": "8.3.0",
    "@capacitor/android": "8.5.3",
    "@capacitor/core": "8.5.3",
    "ical.js": "2.2.1",
    "preact": "11.0.1"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.3",
    "@preact/preset-vite": "2.10.6",
    "@types/web-bluetooth": "0.0.20",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.3"
  }
}
