{
 "version": 1,
 "description": "Photo size rules (shared/CROP.md, 'Photo size'). Worked out by hand, not generated by any app: every app must give exactly these numbers. 'cap': a photo of size 'photo' (width, height, after EXIF orientation) is shrunk to 'capped' on load; the box is max_photo_size for width >= height and the same box turned round for portrait; a photo that fits is not touched; the side that binds gets the box edge and the other side is floor(x + 0.5) (halves up) but at least 1. 'refusal': the header width x height is more than pixel_limit => refused, not shrunk (exactly pixel_limit is accepted). 'megapixels': pixels / 1,000,000 rounded to the nearest integer, halves up; used only in logs (the user-facing message names the limit, not the photo's size).",
 "max_photo_size": [3840, 2160],
 "pixel_limit": 50000000,
 "cap": [
  {"name": "landscape, the height binds", "photo": [6000, 4000], "capped": [3240, 2160]},
  {"name": "portrait, the width binds", "photo": [4000, 6000], "capped": [2160, 3240]},
  {"name": "wide panorama, the width binds", "photo": [12000, 1000], "capped": [3840, 320]},
  {"name": "square counts as landscape", "photo": [7000, 7000], "capped": [2160, 2160]},
  {"name": "landscape, 2500.5 rounds up", "photo": [5001, 4320], "capped": [2501, 2160]},
  {"name": "portrait, 2500.5 rounds up", "photo": [4320, 5001], "capped": [2160, 2501]},
  {"name": "thin strip keeps at least 1 pixel (0.4 would be 0)", "photo": [38400, 4], "capped": [3840, 1]},
  {"name": "thin portrait strip keeps at least 1 pixel (0.9 would be 0)", "photo": [4, 38400], "capped": [1, 3840]},
  {"name": "8000 x 6000 camera photo", "photo": [8000, 6000], "capped": [2880, 2160]},
  {"name": "one pixel too wide", "photo": [3841, 2160], "capped": [3840, 2159]},
  {"name": "one pixel too high", "photo": [3840, 2161], "capped": [3838, 2160]},
  {"name": "portrait, one pixel too high", "photo": [2160, 3841], "capped": [2159, 3840]},
  {"name": "portrait, one pixel too wide", "photo": [2161, 3840], "capped": [2160, 3838]},
  {"name": "small photo is not touched", "photo": [1200, 900], "capped": [1200, 900]},
  {"name": "exactly the landscape box", "photo": [3840, 2160], "capped": [3840, 2160]},
  {"name": "exactly the portrait box", "photo": [2160, 3840], "capped": [2160, 3840]},
  {"name": "one pixel", "photo": [1, 1], "capped": [1, 1]}
 ],
 "refusal": [
  {"name": "49 MP is accepted (and capped)", "photo": [7000, 7000], "refused": false},
  {"name": "exactly 50,000,000 pixels is accepted", "photo": [8000, 6250], "refused": false},
